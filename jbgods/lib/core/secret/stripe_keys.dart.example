// Stripe Keys Template
// IMPORTANT: Copy this file to stripe_keys.dart and add your actual keys
// 
// Steps:
// 1. Copy this file: cp stripe_keys.dart.example stripe_keys.dart
// 2. Replace YOUR_PUBLISHABLE_KEY and YOUR_SECRET_KEY with your actual Stripe keys
// 3. stripe_keys.dart is already in .gitignore, so it won't be committed to git
//
// For production, store these keys securely on a backend server
// This is only for learning/tutorial purposes

class StripeKeys {
  // Replace with your publishable key from Stripe dashboard
  static const String publishableKey = 'YOUR_PUBLISHABLE_KEY';
  
  // Replace with your secret key from Stripe dashboard
  // NEVER expose this in production client-side code
  static const String secretKey = 'YOUR_SECRET_KEY';
}


